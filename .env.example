# Configuration example. Copy to .env.local and adjust.
# The local server reads .env.local then .env; real environment variables take precedence.
# Vite reads the same file, but no VITE_* variable is required: the app always calls /api on its own origin.

# --- Local service ---
PORT=8787
HOST=127.0.0.1
APP_URL=http://127.0.0.1:5173
# STATE_FILE=server/.data/workspace.json

# --- Agent ---
# Without AGENT_API_KEY the deterministic offline provider is used and nothing leaves the machine.
# AGENT_PROVIDER=mock
# AGENT_API_KEY=your-key-here
# AGENT_BASE_URL=https://api.deepseek.com/v1
# Model names differ per account. List what the endpoint accepts before choosing:
#   curl -s "https://api.deepseek.com/v1/models" -H "Authorization: Bearer $AGENT_API_KEY"
# AGENT_MODEL=deepseek-chat

# --- Automatic reminders ---
# idleHours 0 reminds open tasks on the next tick, which is convenient for a demo.
AGENT_TICK_SECONDS=60
AGENT_REMINDER_IDLE_HOURS=48
AGENT_REMINDER_MAX=2
